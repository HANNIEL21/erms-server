// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

// Looking for ways to speed up your queries, or scale easily with your serverless or edge functions?
// Try Prisma Accelerate: https://pris.ly/cli/accelerate-init

generator client {
  provider = "prisma-client"
  output   = "../generated/prisma"
  moduleFormat    = "cjs"
}

datasource db {
  provider = "mysql"
}


model Role {
  id        Int      @id @default(autoincrement())
  name      String   @unique

  // Relations
  users     User[]
  Alumni    Alumni[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([name])
}

model User {
  id        Int        @id @default(autoincrement())
  firstname String
  lastname  String
  email     String     @unique
  password  String
  isActive  Boolean    @default(true)
  refresh_token        String?
  refresh_token_expiry DateTime?
  last_login           DateTime?

  // Foreign Key
  roleId     Int?
  role       Role?     @relation(fields: [roleId], references: [id], onDelete: Restrict)

  createdAt DateTime   @default(now())
  updatedAt DateTime   @updatedAt

  // Relations
  documents        Document[]
  faculty          Faculty[]
  departments      Department[]
  templates        Template[]
  component        Component[]
  block            Block[]
  combo            Combo[]


  // Indexes
  @@index([email])
  @@index([roleId])
  @@index([isActive])
}

model Alumni {
  id                   Int        @id @default(autoincrement())
  firstname            String
  lastname             String
  middlename           String?
  email                String     @unique
  matric_number        String     @unique
  gender               String?
  date_of_birth        DateTime?
  phone_number         String?
  address              String?
  password             String?

  // Foreign Key
  roleId     Int?
  role       Role?     @relation(fields: [roleId], references: [id], onDelete: Restrict) 

  refresh_token        String?
  refresh_token_expiry DateTime?
  last_login           DateTime?
  isActive             Boolean    @default(false)
  createdAt            DateTime   @default(now())
  updatedAt            DateTime   @updatedAt
  data                 Json?

  // Relations
  requests    Request[]
  payments    Payment[]

  // Indexes
  @@index([email])
  @@index([matric_number])
  @@index([roleId])
  @@index([isActive])
}

model Document {
  id            Int       @id @default(autoincrement())
  title         String    @unique
  description   String?
  status        String    @default("DRAFT") // PENDING, APPROVED, REJECTED, etc.
  price         Int       @default(0)
  processingFee Int       @default(0)
  totalAmount   Int       @default(0)
  
  // Foreign key and relation
  createdById   Int
  createdBy     User      @relation(fields: [createdById], references: [id], onDelete: Cascade)

  requests      Request[]
  templates     Template[]
  
  // Timestamps
  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt
  
  // Indexes
  @@index([createdById])
  @@index([status])
  @@index([createdAt])
}

model Request {
  id               Int       @id @default(autoincrement())
  type             String
  email            String?
  destination      String?
  reference_number String    @unique @default(cuid())
  status           String    @default("PENDING")

  // Foreign Key
  userId           Int
  user             Alumni    @relation(fields: [userId], references: [id])

  documentId       Int
  document         Document    @relation(fields: [documentId], references: [id])

  createdAt        DateTime  @default(now())
  updatedAt        DateTime  @updatedAt

  payments         Payment[]

  // Indexes
  @@index([userId])
  @@index([status])
  @@index([createdAt])
}

model Payment {
  id                String        @id @default(cuid())
  gateway_name      String     @default("PAYSTACK")
  gateway_response  Json?
  transaction_id    String?    @unique
  totalAmount       Int
  email             String?
  status            String     @default("PENDING")
  reference         String?    @unique
  access_code       String?

  // Foreign Key
  userId            Int
  user              Alumni     @relation(fields: [userId], references: [id])

  requestId         Int?
  request           Request?    @relation(fields: [requestId], references: [id]) 

  createdAt         DateTime   @default(now())
  updatedAt         DateTime   @updatedAt

  // Indexes
  @@index([userId])
  @@index([status])
  @@index([createdAt])
}

model Faculty {
  id            Int          @id @default(autoincrement())
  name          String       @unique

  // Audit
  createdById   Int?
  createdBy     User?        @relation(fields: [createdById], references: [id], onDelete: Cascade)

  // Relations
  departments   Department[]

  // Timestamps
  createdAt     DateTime     @default(now())
  updatedAt     DateTime     @updatedAt

  // Indexes
  @@index([name])
  @@index([createdById])
}

model Department {
  id            Int          @id @default(autoincrement())
  name          String       @unique

  // Audit
  createdById   Int?
  createdBy     User?        @relation(fields: [createdById], references: [id], onDelete: Cascade)

  // Relations
  facultyId     Int
  faculty       Faculty      @relation(fields: [facultyId], references: [id], onDelete: Restrict)

  // Timestamps
  createdAt     DateTime     @default(now())
  updatedAt     DateTime     @updatedAt

  // Constraints & Indexes
  @@unique([name, facultyId])
  @@index([facultyId])
  @@index([createdById])
  @@index([name])
}

model Template {
  id            Int       @id @default(autoincrement())
  name          String    @unique
  description   String?
  version       String
  isActive      Boolean   @default(false)

  // Relations
  documentId    Int
  document      Document  @relation(fields: [documentId], references: [id], onDelete: Restrict)

  createdById   Int
  createdBy     User      @relation(fields: [createdById], references: [id], onDelete: Cascade)

  components    TemplateComponent[]
  versions      TemplateVersion[]

  // Timestamps
  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt

  @@index([isActive])
  @@index([createdById])
}

model Component {
  id            Int       @id @default(autoincrement())
  name          String
  description   String?
  layoutType    String   // e.g. column, row, grid

  // Relations
  createdById   Int
  createdBy     User     @relation(fields: [createdById], references: [id])

  blocks        ComponentBlock[]
  templates     TemplateComponent[]

  // Timestamps
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  @@unique([name])
  @@index([createdById])
}

model Block {
  id            Int       @id @default(autoincrement())
  name          String
  blockType     String   // Typography, Image, Signature, QRCode
  defaultValue  String?
  isDynamic     Boolean  @default(false)

  // Relations
  createdById   Int
  createdBy     User     @relation(fields: [createdById], references: [id], onDelete: Cascade)

  components    ComponentBlock[]

  // Timestamps
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  @@unique([name])
  @@index([blockType])
}

model ComponentBlock {
  id           Int     @id @default(autoincrement())
  position     Int

  componentId  Int
  component    Component @relation(fields: [componentId], references: [id], onDelete: Cascade)

  blockId      Int
  block        Block     @relation(fields: [blockId], references: [id], onDelete: Restrict)

  @@unique([componentId, position])
  @@index([componentId])
}

model TemplateComponent {
  id           Int     @id @default(autoincrement())
  position     Int

  templateId   Int
  template     Template  @relation(fields: [templateId], references: [id], onDelete: Cascade)

  componentId  Int
  component    Component @relation(fields: [componentId], references: [id], onDelete: Restrict)

  @@unique([templateId, position])
  @@index([templateId])
}

model TemplateVersion {
  id            Int       @id @default(autoincrement())
  version       String
  snapshot      Json     // full rendered structure

  templateId    Int
  template      Template  @relation(fields: [templateId], references: [id], onDelete: Restrict)

  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt

  @@unique([templateId, version])
}

model Combo{
  id            Int       @id @default(autoincrement())
  firstname     String
  middlename    String?
  lastname      String
  email                String     @unique
  matric_number        String     @unique
  phone_number         String?
  isPrinted            Boolean    @default(false)

  // Foreign key and relation
  createdById   Int
  createdBy     User      @relation(fields: [createdById], references: [id])

  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt
}



